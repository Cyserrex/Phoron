<ui:FluentWindow x:Class="Phoron.App.PanelRingkas"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Phoron.App"
                 Title="Phoron" Width="560" SizeToContent="Height"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <!-- Panel kontrol ringkas: tampilan utama Phoron. Pekerjaan sehari-hari -
         memastikan PHP jalan, menjalankan proyek Node, membuka situs - muat di
         sini; halaman lengkap dibuka dari laci di bawah. Tingginya mengikuti
         isi (SizeToContent), jadi laci memanjangkan jendela ke bawah. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="BilahJudul" Grid.Row="0" Title="Phoron" ShowMaximize="False"/>

        <StackPanel Grid.Row="1" Margin="12,4,12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:T 'Profil aktif'}" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" x:Name="CmbProfil" SelectionChanged="CmbProfil_Changed"/>
                <!-- Hanya muncul bila profil lain dipilih. -->
                <ui:Button Grid.Column="2" x:Name="BtnGanti" Content="{loc:T 'Switch'}" Appearance="Primary"
                           Margin="8,0,0,0" Visibility="Collapsed" Click="BtnGanti_Click"
                           ToolTip="{loc:T 'Pindah ke profil ini tanpa mengubah keadaan layanan'}"/>
            </Grid>

            <!-- Baris layanan dan proyek Node, dirakit dari kode (IsiBaris). -->
            <Border Margin="0,10,0,0" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel x:Name="DaftarBaris"/>
            </Border>

            <UniformGrid Columns="4" Margin="0,10,0,0">
                <ui:Button Content="localhost" HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="BtnLocalhost_Click"/>
                <ui:Button Content="{loc:T 'Basis data'}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="BtnDatabase_Click"/>
                <ui:Button Content="{loc:T 'Terminal'}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="BtnTerminal_Click"/>
                <ui:Button Content="{loc:T 'Folder proyek'}" HorizontalAlignment="Stretch" Click="BtnFolder_Click"/>
            </UniformGrid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BtnDaya" Appearance="Primary" HorizontalAlignment="Stretch"
                           Padding="0,9" FontWeight="SemiBold" Click="BtnDaya_Click"/>
                <ui:Button Grid.Column="1" x:Name="BtnLaci" Width="160" Margin="8,0,0,0" Padding="0,9"
                           Click="BtnLaci_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtLaci" Text="{loc:T 'Menu lengkap'}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="IkonLaci" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </StackPanel>

        <!-- Laci: jalan ke halaman lengkap dan beberapa baris aktivitas terakhir. -->
        <Border x:Name="Laci" Grid.Row="2" Visibility="Collapsed" Padding="12,10,12,12"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel>
                <UniformGrid Columns="4">
                    <ui:Button Tag="situs" Content="{loc:T 'Situs'}" HorizontalAlignment="Stretch" Margin="0,0,6,6" Click="BtnHalaman_Click"/>
                    <ui:Button Tag="basisdata" Content="{loc:T 'Basis data'}" HorizontalAlignment="Stretch" Margin="0,0,6,6" Click="BtnHalaman_Click"/>
                    <ui:Button Tag="node" Content="{loc:T 'Node / TS'}" HorizontalAlignment="Stretch" Margin="0,0,6,6" Click="BtnHalaman_Click"/>
                    <ui:Button Tag="profil" Content="{loc:T 'Profil'}" HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="BtnHalaman_Click"/>
                    <ui:Button Tag="versi" Content="{loc:T 'Versi'}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="BtnHalaman_Click"/>
                    <ui:Button Tag="ekstensi" Content="{loc:T 'Ekstensi PHP'}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="BtnHalaman_Click"/>
                    <ui:Button Tag="log" Content="{loc:T 'Log'}" HorizontalAlignment="Stretch" Margin="0,0,6,0" Click="BtnHalaman_Click"/>
                    <ui:Button Tag="setelan" Content="{loc:T 'Pengaturan'}" HorizontalAlignment="Stretch" Click="BtnHalaman_Click"/>
                </UniformGrid>
                <Border Margin="0,10,0,0" CornerRadius="6" Padding="10,8" BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <TextBlock x:Name="TxtLog" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" MinHeight="64"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="12,4,12,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <TextBlock x:Name="TxtStatus" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</ui:FluentWindow>
