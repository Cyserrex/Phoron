<ui:FluentWindow x:Class="Phoron.App.DownloadWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App"
                 Title="Mengunduh pembaruan" Width="460" SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Mengunduh pembaruan"
                     ShowMaximize="False" ShowMinimize="False" ShowClose="False"/>

        <StackPanel Grid.Row="1" Margin="20,10,20,20">
            <TextBlock x:Name="TxtJudul" Text="Phoron" FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtSumber" Text="" Opacity="0.7" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="100"/>

            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="TxtUkuran" Text="Menyambung..." FontSize="12" Opacity="0.8"/>
                <TextBlock x:Name="TxtPersen" Text="" FontSize="12" FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
            </Grid>

            <ui:Button x:Name="BtnBatal" Content="Batalkan" Margin="0,18,0,0"
                       HorizontalAlignment="Right" Click="BtnBatal_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
