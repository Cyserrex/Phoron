<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Class="Phoron.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Tema WPF UI: warna Fluent, lalu gaya semua kontrol. Tema yang
                     sebenarnya dipakai ditentukan saat jendela dibuat, mengikuti
                     setelan terang/gelap Windows. -->
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Gaya ComboBox WPF UI menyembunyikan scrollbar daftarnya. Tanpa
                 scrollbar, satu-satunya cara menggulir dengan klik adalah
                 menekan lalu menyeret isi daftar - dan ComboBox WPF menjawab
                 seretan yang keluar dari tepi atas dengan melompat ke item
                 paling atas, lalu MEMILIHNYA saat tombol dilepas.
                 BasedOn HARUS menyebut kunci gaya WPF UI dengan namanya:
                 {x:Type ComboBox} di sini terurai menjadi null, dan dropdown
                 jatuh ke tampilan klasik Windows (1.35.2). -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>

            <!-- Judul seksi di dalam halaman. -->
            <Style x:Key="Judul" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>
            <Style x:Key="SubJudul" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
            <Style x:Key="Label" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Opacity" Value="0.8"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
