<UserControl x:Class="Phoron.App.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,10,4">
        <StackPanel>
            <TextBlock Text="{loc:T 'Tentang'}" Style="{StaticResource Judul}"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="18" Margin="0,6,0,12">
                <StackPanel Orientation="Horizontal">
                    <!-- Ikonnya diambil dari exe sendiri, bukan berkas terpisah:
                         satu berkas gambar lagi berarti satu berkas lagi yang
                         bisa lupa disertakan installer. -->
                    <Image x:Name="Logo" Width="64" Height="64" VerticalAlignment="Top"
                           Margin="0,0,18,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Phoron" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtVersi" Opacity="0.8" Margin="0,2,0,0"/>
                        <TextBlock x:Name="TxtHakCipta" Margin="0,10,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:T 'Lingkungan pengembangan web lokal: Apache, PHP, MySQL, dan Node dalam satu tempat, dengan kombinasi versi yang bisa disimpan sebagai profil lalu ditukar sekali klik.'}"
                                   TextWrapping="Wrap" Opacity="0.8" MaxWidth="560"
                                   Margin="0,8,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{loc:T 'Yang sedang dipakai'}" Style="{StaticResource Label}"/>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="14" Margin="0,0,0,12">
                <StackPanel x:Name="PanelRinci"/>
            </Border>

            <TextBlock Text="{loc:T 'Tautan'}" Style="{StaticResource Label}"/>
            <WrapPanel Margin="0,0,0,12">
                <ui:Button Content="{loc:T 'Halaman proyek di GitHub'}" Margin="0,0,8,8" Click="BtnRepo_Click"/>
                <ui:Button Content="{loc:T 'Buka halaman rilis'}" Margin="0,0,8,8" Click="BtnRilis_Click"/>
                <ui:Button Content="{loc:T 'Cek pembaruan sekarang'}" Margin="0,0,8,8" Click="BtnCek_Click"/>
                <ui:Button Content="{loc:T 'Salin info versi'}" Margin="0,0,8,8" Click="BtnSalin_Click"/>
            </WrapPanel>

            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:T 'Phoron memakai Apache, PHP, MySQL/MariaDB, Nginx, dan Node.js yang masing-masing punya lisensi sendiri. Phoron tidak pernah menulis ke dalam folder bin milik program itu - seluruh konfigurasi yang dihasilkan disimpan di folder etc.'}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
