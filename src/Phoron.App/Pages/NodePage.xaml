<UserControl x:Class="Phoron.App.Pages.NodePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <Grid Margin="4,8,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T 'Node / TypeScript'}" Style="{StaticResource Judul}"/>
            <TextBlock x:Name="TxtInfo" Style="{StaticResource SubJudul}"
                       Text="{loc:T 'Jalankan Next.js, Astro, Vite, dan proyek Node lain dari folder mana pun.'}"/>
        </StackPanel>

        <ListView x:Name="Daftar" Grid.Row="1" Margin="0,0,0,10"
                  SelectionChanged="Daftar_Changed" MouseDoubleClick="Daftar_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:T 'Proyek'}" Width="150" DisplayMemberBinding="{Binding Nama}"/>
                    <GridViewColumn Header="{loc:T 'Folder'}" Width="230" DisplayMemberBinding="{Binding Folder}"/>
                    <GridViewColumn Header="{loc:T 'Kerangka'}" Width="85" DisplayMemberBinding="{Binding Kerangka}"/>
                    <GridViewColumn Header="{loc:T 'Perintah'}" Width="120" DisplayMemberBinding="{Binding Perintah}"/>
                    <GridViewColumn Header="{loc:T 'Status'}" Width="80" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="{loc:T 'Alamat'}" Width="170" DisplayMemberBinding="{Binding Alamat}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:T 'Skrip'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" x:Name="CmbSkrip" MinWidth="130" Margin="0,0,16,0"
                          SelectionChanged="CmbSkrip_Changed"/>
                <TextBlock Grid.Column="2" Text="{loc:T 'Node'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="3" x:Name="CmbNode" MinWidth="200"
                          SelectionChanged="CmbNode_Changed"/>
            </Grid>
            <WrapPanel>
                <ui:Button x:Name="BtnJalan" Content="{loc:T 'Jalankan'}" Appearance="Primary"
                           Margin="0,0,8,0" Click="BtnJalan_Click"/>
                <ui:Button Content="{loc:T 'Tambah proyek...'}" Margin="0,0,8,0" Click="BtnTambah_Click"/>
                <ui:Button Content="{loc:T 'Buka alamat'}" Margin="0,0,8,0" Click="BtnBuka_Click"/>
                <ui:Button Content="{loc:T 'Buka folder'}" Margin="0,0,8,0" Click="BtnFolder_Click"/>
                <ui:Button Content="{loc:T 'Terminal di sini'}" Margin="0,0,8,0" Click="BtnTerminal_Click"/>
                <ui:Button Content="npm install" Margin="0,0,8,0" Click="BtnInstall_Click"/>
                <ui:Button Content="{loc:T 'Hapus dari daftar'}" Click="BtnHapus_Click"/>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtJudulLog" Text="{loc:T 'Keluaran'}" Margin="0,0,0,6"
                           FontWeight="SemiBold" FontSize="12" Opacity="0.8"/>
                <!-- RichTextBox, bukan TextBox: tiap baris perlu warnanya sendiri,
                     sama seperti panel Aktivitas di Beranda. Keluaran server
                     pengembangan panjang dan seragam, dan satu baris galat di
                     tengahnya sulit sekali ditemukan tanpa warna. Padding
                     paragraf dinolkan supaya rapat seperti keluaran terminal. -->
                <RichTextBox Grid.Row="1" x:Name="TxtLog" IsReadOnly="True" IsDocumentEnabled="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             BorderThickness="0" Background="Transparent">
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
