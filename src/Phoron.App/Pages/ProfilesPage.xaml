<UserControl x:Class="Phoron.App.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <Grid Margin="4,8,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T 'Profil'}" Style="{StaticResource Judul}"/>
            <TextBlock Style="{StaticResource SubJudul}"
                       Text="{loc:T 'Satu profil = satu kombinasi versi + port. Simpan sebanyak yang perlu, lalu tinggal switch.'}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <ui:Button Content="{loc:T 'Profil baru'}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Margin="0,0,0,6" Click="BtnBaru_Click"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="{loc:T 'Duplikat'}" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" Margin="0,0,3,0" Click="BtnDuplikat_Click"/>
                        <ui:Button Grid.Column="1" Content="{loc:T 'Hapus'}" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center" Margin="3,0,0,0" Click="BtnHapus_Click"/>
                    </Grid>
                </StackPanel>
                <ListBox x:Name="Daftar" SelectionChanged="Daftar_Changed" DisplayMemberPath="Name"/>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel x:Name="Editor">
                    <TextBlock Text="{loc:T 'Nama profil'}" Style="{StaticResource Label}"/>
                    <ui:TextBox x:Name="TxtNama" LostFocus="Teks_Lepas"/>

                    <TextBlock Text="{loc:T 'Web server'}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbWeb" SelectionChanged="CmbWeb_Changed">
                        <ComboBoxItem Content="Apache" Tag="apache"/>
                        <ComboBoxItem Content="Nginx" Tag="nginx"/>
                    </ComboBox>

                    <TextBlock Text="{loc:T 'Versi PHP'}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbPhp" SelectionChanged="Kendali_Ubah"/>

                    <TextBlock x:Name="LblApache" Text="{loc:T 'Versi Apache'}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbApache" SelectionChanged="Kendali_Ubah"/>

                    <TextBlock x:Name="LblNginx" Text="{loc:T 'Versi Nginx'}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbNginx" SelectionChanged="Kendali_Ubah"/>

                    <TextBlock Text="{loc:T 'Versi MySQL / MariaDB'}" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="CmbMysql" SelectionChanged="Kendali_Ubah"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{loc:T 'Port HTTP'}" Style="{StaticResource Label}"/>
                            <ui:TextBox x:Name="TxtPortHttp" LostFocus="Teks_Lepas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="3,0,3,0">
                            <TextBlock Text="{loc:T 'Port HTTPS'}" Style="{StaticResource Label}"/>
                            <ui:TextBox x:Name="TxtPortHttps" LostFocus="Teks_Lepas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="{loc:T 'Port MySQL'}" Style="{StaticResource Label}"/>
                            <ui:TextBox x:Name="TxtPortMysql" LostFocus="Teks_Lepas"/>
                        </StackPanel>
                    </Grid>

                    <!-- Penyuntingnya pindah ke halaman Situs: di sana sebabnya
                         (folder mana) duduk bersebelahan dengan akibatnya (situs
                         apa yang muncul). Ringkasan ini tetap ada supaya halaman
                         Profil tidak berbohong soal isi profil. -->
                    <TextBlock Text="{loc:T 'Folder proyek'}" Style="{StaticResource Label}"/>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8" Padding="12" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtRingkasRoot" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{loc:T 'Akhiran nama situs'}" Style="{StaticResource Label}"/>
                    <ui:TextBox x:Name="TxtSuffix" LostFocus="Teks_Lepas" PlaceholderText="test"/>

                    <TextBlock Text="{loc:T 'Catatan'}" Style="{StaticResource Label}"/>
                    <ui:TextBox x:Name="TxtCatatan" LostFocus="Teks_Lepas" AcceptsReturn="True" Height="60"
                                TextWrapping="Wrap" VerticalContentAlignment="Top"/>

                    <!-- Pengganti kotak dialog yang dulu muncul saat menekan
                         Simpan. Simpan-seketika tidak boleh menyela ketikan
                         dengan dialog, jadi keberatannya ditulis di sini dan
                         tinggal di layar selama masih berlaku. -->
                    <Border x:Name="PanelMasalah" Visibility="Collapsed" Margin="0,14,0,0"
                            Background="#33E0A020" CornerRadius="8" Padding="12">
                        <TextBlock x:Name="TxtMasalah" TextWrapping="Wrap"/>
                    </Border>

                    <Border x:Name="PanelRestart" Visibility="Collapsed" Margin="0,10,0,0"
                            Background="#33E0A020" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center"
                                       Content="{loc:T 'Nyalakan ulang web server'}" Click="BtnRestart_Click"/>
                            <TextBlock x:Name="TxtRestart" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                        <ui:Button Content="{loc:T 'Switch ke profil ini'}" Appearance="Primary"
                                   Margin="0,0,8,0" Click="BtnSwitch_Click"/>
                        <!-- Menjawab "versi mana cocok dengan mana" - pertanyaan
                             yang jadi sulit begitu XAMPP dan Laragon dipakai
                             berdampingan dengan arsitektur berbeda. -->
                        <ui:Button Content="{loc:T 'Sarankan otomatis'}" Click="BtnSaran_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtStatusSimpan" Style="{StaticResource SubJudul}" FontSize="12"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="{loc:T 'Setiap perubahan langsung tersimpan ke berkas profil - tidak ada tombol simpan.'}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
