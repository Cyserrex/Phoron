<UserControl x:Class="Phoron.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="Pengaturan" Style="{StaticResource Judul}"/>
            <TextBlock Style="{StaticResource SubJudul}"
                       Text="Setiap perubahan langsung tersimpan ke phoron.ini - tidak ada tombol simpan."/>

            <ui:ToggleSwitch x:Name="SwWindows" Margin="0,4,0,4"
                             Content="Jalankan Phoron saat Windows dinyalakan"
                             Checked="SwWindows_Ubah" Unchecked="SwWindows_Ubah"/>
            <TextBlock x:Name="TxtWindows" Style="{StaticResource SubJudul}" FontSize="12"
                       Margin="52,0,0,10"
                       Text="Phoron mulai langsung mengecil ke baki sistem, tanpa memunculkan jendela."/>

            <ui:ToggleSwitch x:Name="SwAutoStart" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,10"
                             Content="Nyalakan layanan otomatis saat Phoron dibuka"/>
            <ui:ToggleSwitch x:Name="SwTray" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,10"
                             Content="Tombol tutup mengecilkan ke baki sistem, bukan keluar"/>
            <ui:ToggleSwitch x:Name="SwVhost" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,10"
                             Content="Buat vhost otomatis untuk tiap folder di www"/>
            <ui:ToggleSwitch x:Name="SwHosts" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,10"
                             Content="Sinkronkan berkas hosts Windows (butuh Administrator)"/>

            <ui:ToggleSwitch x:Name="SwLogRinci" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,4"
                             Content="Catat log rinci"/>
            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,10"
                       Text="Baku mati agar Phoron ringan: log akses Apache dan seluruh keluaran layanan tidak ditulis (mysqld sendiri mencetak ratusan baris tiap kali menyala). Log GALAT Apache, MySQL, dan PHP tetap menyala — itulah yang menjelaskan kalau ada yang rusak."/>

            <ui:ToggleSwitch x:Name="SwPhpIni" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,4"
                             Content="Tulis php.ini ke dalam folder PHP"/>
            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,10"
                       Text="Baku: php.ini ditulis ke etc\php\&lt;versi&gt;\ dan folder PHP tidak disentuh. Nyalakan kalau Anda ingin php.exe dari editor atau Composer di luar Phoron ikut memakai setelan yang sama. Hati-hati bila versi PHP-nya dipinjam dari Laragon - berkasnya dipakai bersama. php.ini asli dicadangkan sekali ke php.ini.sebelum-phoron."/>

            <TextBlock Text="Terminal" Style="{StaticResource Label}"/>
            <ComboBox x:Name="CmbTerminal" Width="240" HorizontalAlignment="Left"
                      SelectionChanged="CmbTerminal_Ubah">
                <ComboBoxItem Content="Command Prompt" Tag="cmd"/>
                <ComboBoxItem Content="PowerShell" Tag="powershell"/>
                <ComboBoxItem Content="Windows Terminal" Tag="wt"/>
            </ComboBox>

            <TextBlock Text="Folder bin yang dipindai" Style="{StaticResource Label}"/>
            <TextBlock Style="{StaticResource SubJudul}"
                       Text="Satu folder per baris. Folder bin Laragon boleh ikut - Phoron tidak pernah menulis ke dalamnya."/>
            <!-- Disimpan saat kehilangan fokus, bukan tiap ketukan: mengubah
                 daftar folder bin memicu pemindaian ulang seluruh versi, dan
                 melakukannya per huruf yang diketik akan membuat kotak ini macet. -->
            <ui:TextBox x:Name="TxtRoots" AcceptsReturn="True" Height="110"
                        TextWrapping="NoWrap" VerticalContentAlignment="Top"
                        LostFocus="TxtRoots_Lepas"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Status hak akses" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtAdmin" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ui:Button x:Name="BtnAdmin" Content="Jalankan ulang sebagai Administrator"
                               Click="BtnAdmin_Click"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Folder Phoron" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtRoot" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <ui:Button Content="Buka folder instalasi" Margin="0,0,8,0" Click="BtnRoot_Click"/>
                        <ui:Button Content="Buka phoron.ini" Margin="0,0,8,0" Click="BtnIni_Click"/>
                        <ui:Button Content="Buang blok hosts milik Phoron" Click="BtnBersihHosts_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>


            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Pembaruan" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <ui:ToggleSwitch x:Name="SwCekPembaruan" Checked="Sw_Ubah" Unchecked="Sw_Ubah"
                                     Margin="0,0,0,4"
                                     Content="Cek rilis baru di GitHub saat Phoron dibuka"/>
                    <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,10"
                               Text="Pengecekan dilewati kalau baru dilakukan dalam 6 jam terakhir - API GitHub tanpa token dibatasi 60 permintaan per jam."/>
                    <TextBlock x:Name="TxtPembaruan" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <ui:Button x:Name="BtnCek" Content="Cek pembaruan sekarang"
                                   Margin="0,0,8,0" Click="BtnCek_Click"/>
                        <ui:Button Content="Buka halaman rilis" Click="BtnRilis_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtVersi" Opacity="0.6" FontSize="11" Margin="0,12,0,10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
