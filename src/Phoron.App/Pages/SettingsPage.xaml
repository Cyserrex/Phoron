<UserControl x:Class="Phoron.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="Pengaturan" Style="{StaticResource Judul}"/>
            <TextBlock Style="{StaticResource SubJudul}"
                       Text="Tersimpan di phoron.ini pada folder instalasi."/>

            <ui:ToggleSwitch x:Name="SwWindows" Margin="0,4,0,4"
                             Content="Jalankan Phoron saat Windows dinyalakan"
                             Checked="SwWindows_Ubah" Unchecked="SwWindows_Ubah"/>
            <TextBlock x:Name="TxtWindows" Style="{StaticResource SubJudul}" FontSize="12"
                       Margin="52,0,0,10"
                       Text="Phoron mulai langsung mengecil ke baki sistem, tanpa memunculkan jendela."/>

            <ui:ToggleSwitch x:Name="SwAutoStart" Margin="0,0,0,10"
                             Content="Nyalakan layanan otomatis saat Phoron dibuka"/>
            <ui:ToggleSwitch x:Name="SwTray" Margin="0,0,0,10"
                             Content="Tombol tutup mengecilkan ke baki sistem, bukan keluar"/>
            <ui:ToggleSwitch x:Name="SwVhost" Margin="0,0,0,10"
                             Content="Buat vhost otomatis untuk tiap folder di www"/>
            <ui:ToggleSwitch x:Name="SwHosts" Margin="0,0,0,10"
                             Content="Sinkronkan berkas hosts Windows (butuh Administrator)"/>

            <TextBlock Text="Terminal" Style="{StaticResource Label}"/>
            <ComboBox x:Name="CmbTerminal" Width="240" HorizontalAlignment="Left">
                <ComboBoxItem Content="Command Prompt" Tag="cmd"/>
                <ComboBoxItem Content="PowerShell" Tag="powershell"/>
                <ComboBoxItem Content="Windows Terminal" Tag="wt"/>
            </ComboBox>

            <TextBlock Text="Folder bin yang dipindai" Style="{StaticResource Label}"/>
            <TextBlock Style="{StaticResource SubJudul}"
                       Text="Satu folder per baris. Folder bin Laragon boleh ikut - Phoron tidak pernah menulis ke dalamnya."/>
            <ui:TextBox x:Name="TxtRoots" AcceptsReturn="True" Height="110"
                        TextWrapping="NoWrap" VerticalContentAlignment="Top"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Status hak akses" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtAdmin" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ui:Button x:Name="BtnAdmin" Content="Jalankan ulang sebagai Administrator"
                               Click="BtnAdmin_Click"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Folder Phoron" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtRoot" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <ui:Button Content="Buka folder instalasi" Margin="0,0,8,0" Click="BtnRoot_Click"/>
                        <ui:Button Content="Buka phoron.ini" Margin="0,0,8,0" Click="BtnIni_Click"/>
                        <ui:Button Content="Buang blok hosts milik Phoron" Click="BtnBersihHosts_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
                <ui:Button Content="Simpan pengaturan" Appearance="Primary" Click="BtnSimpan_Click"/>
            </StackPanel>

            <TextBlock x:Name="TxtVersi" Opacity="0.6" FontSize="11" Margin="0,4,0,10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
