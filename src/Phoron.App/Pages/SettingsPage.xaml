<UserControl x:Class="Phoron.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="{loc:T 'Pengaturan'}" Style="{StaticResource Judul}"/>
            <TextBlock Style="{StaticResource SubJudul}"
                       Text="{loc:T 'Setiap perubahan langsung tersimpan ke phoron.ini - tidak ada tombol simpan.'}"/>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{loc:T 'Tema'}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTema" HorizontalAlignment="Stretch"
                                  SelectionChanged="CmbTema_Ubah">
                            <ComboBoxItem Content="{loc:T 'Ikut Windows'}" Tag="sistem"/>
                            <ComboBoxItem Content="{loc:T 'Terang'}" Tag="terang"/>
                            <ComboBoxItem Content="{loc:T 'Gelap'}" Tag="gelap"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{loc:T 'Bahasa'}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <!-- Nama bahasa TIDAK diterjemahkan: orang mencari
                             "English" atau "Basa Jawa", bukan padanannya dalam
                             bahasa yang sedang aktif - yang justru tidak mereka
                             kenali kalau salah pilih dan ingin kembali. -->
                        <ComboBox x:Name="CmbBahasa" HorizontalAlignment="Stretch"
                                  SelectionChanged="CmbBahasa_Ubah"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ui:ToggleSwitch x:Name="SwWindows" Margin="0,4,0,4"
                             Content="{loc:T 'Jalankan Phoron saat Windows dinyalakan'}"
                             Checked="SwWindows_Ubah" Unchecked="SwWindows_Ubah"/>
            <TextBlock x:Name="TxtWindows" Style="{StaticResource SubJudul}" FontSize="12"
                       Margin="52,0,0,10"
                       Text="{loc:T 'Phoron mulai langsung mengecil ke baki sistem, tanpa memunculkan jendela.'}"/>

            <ui:ToggleSwitch x:Name="SwAutoStart" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,10"
                             Content="{loc:T 'Nyalakan layanan otomatis saat Phoron dibuka'}"/>
            <ui:ToggleSwitch x:Name="SwTray" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,10"
                             Content="{loc:T 'Tombol tutup mengecilkan ke baki sistem, bukan keluar'}"/>
            <ui:ToggleSwitch x:Name="SwVhost" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,10"
                             Content="{loc:T 'Buat vhost otomatis untuk tiap folder di www'}"/>
            <ui:ToggleSwitch x:Name="SwHosts" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,4"
                             Content="{loc:T 'Sinkronkan berkas hosts Windows (butuh Administrator)'}"/>
            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,6"
                       Text="{loc:T 'Saat dinyalakan Windows lewat autostart, Phoron selalu jalan tanpa hak Administrator - Windows memang begitu, supaya tidak ada kotak UAC di tiap boot. Entri berkas hosts sendiri menetap, jadi cukup didaftarkan sekali: sesudah itu nama .test tetap hidup walau Phoron jalan sebagai pengguna biasa.'}"/>
            <ui:Button x:Name="BtnDaftarHosts" Margin="52,0,0,10"
                       Content="{loc:T 'Daftarkan nama situs sekali'}" Click="BtnDaftarHosts_Click"/>

            <ui:ToggleSwitch x:Name="SwBerandaAkar" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,4"
                             Content="{loc:T 'Tampilkan beranda Phoron di http://localhost/'}"/>
            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,10"
                       Text="{loc:T 'Hanya alamat akar yang dialihkan. Subfolder seperti /simpdam/ tidak tersentuh, dan index.php milik folder proyek tetap bisa dibuka di /index.php. Matikan kalau akar folder proyek Anda memang aplikasi sendiri.'}"/>

            <ui:ToggleSwitch x:Name="SwLogRinci" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,4"
                             Content="{loc:T 'Catat log rinci'}"/>
            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,10"
                       Text="{loc:T 'Baku mati agar Phoron ringan: log akses Apache dan seluruh keluaran layanan tidak ditulis (mysqld sendiri mencetak ratusan baris tiap kali menyala). Log GALAT Apache, MySQL, dan PHP tetap menyala — itulah yang menjelaskan kalau ada yang rusak.'}"/>

            <ui:ToggleSwitch x:Name="SwPhpIni" Checked="Sw_Ubah" Unchecked="Sw_Ubah" Margin="0,0,0,4"
                             Content="{loc:T 'Tulis php.ini ke dalam folder PHP'}"/>
            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,10">
                <TextBlock.Text>
                    <!-- Bentuk elemen: parser markup extension memakan "\". -->
                    <loc:T Teks="Baku: php.ini ditulis ke etc\php\&lt;versi&gt;\ dan folder PHP tidak disentuh. Nyalakan kalau Anda ingin php.exe dari editor atau Composer di luar Phoron ikut memakai setelan yang sama. Hati-hati bila versi PHP-nya dipinjam dari Laragon - berkasnya dipakai bersama. php.ini asli dicadangkan sekali ke php.ini.sebelum-phoron."/>
                </TextBlock.Text>
            </TextBlock>

            <TextBlock Text="{loc:T 'Terminal'}" Style="{StaticResource Label}"/>
            <ComboBox x:Name="CmbTerminal" Width="240" HorizontalAlignment="Left"
                      SelectionChanged="CmbTerminal_Ubah">
                <ComboBoxItem Content="Command Prompt" Tag="cmd"/>
                <ComboBoxItem Content="PowerShell" Tag="powershell"/>
                <ComboBoxItem Content="Windows Terminal" Tag="wt"/>
            </ComboBox>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:T 'Status hak akses'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtAdmin" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ui:Button x:Name="BtnAdmin" Content="{loc:T 'Jalankan ulang sebagai Administrator'}"
                               Click="BtnAdmin_Click"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:T 'Folder Phoron'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtRoot" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <ui:Button Content="{loc:T 'Buka folder instalasi'}" Margin="0,0,8,0" Click="BtnRoot_Click"/>
                        <ui:Button Content="{loc:T 'Buka phoron.ini'}" Margin="0,0,8,0" Click="BtnIni_Click"/>
                        <ui:Button Content="{loc:T 'Buang blok hosts milik Phoron'}" Click="BtnBersihHosts_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>


            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8"
                    Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:T 'Pembaruan'}" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <ui:ToggleSwitch x:Name="SwCekPembaruan" Checked="Sw_Ubah" Unchecked="Sw_Ubah"
                                     Margin="0,0,0,4"
                                     Content="{loc:T 'Cek rilis baru di GitHub saat Phoron dibuka'}"/>
                    <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="52,0,0,10"
                               Text="{loc:T 'Phoron membaca umpan rilis GitHub, yang tidak dibatasi jatah permintaan - jadi token TIDAK diperlukan. Pengecekan tetap dilewati kalau baru dilakukan beberapa jam terakhir.'}"/>
                    <TextBlock x:Name="TxtPembaruan" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Token menaikkan jatah 60 -> 5.000 permintaan per jam.
                         Batas 60 itu berlaku per ALAMAT IP, bukan per aplikasi,
                         jadi di jaringan kantor jatahnya habis oleh alat lain
                         sebelum Phoron sempat memakainya. -->
                    <TextBlock Text="{loc:T 'Token GitHub (opsional)'}" Style="{StaticResource Label}"/>
                    <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Text="{loc:T 'Hampir selalu tidak perlu diisi: jalur utama Phoron memakai umpan rilis yang tanpa batas jatah. Token hanya berguna kalau jaringan Anda memblokir umpan itu sehingga Phoron jatuh ke API, yang dibatasi 60 permintaan per jam. Token TIDAK perlu diberi izin apa pun, dan disimpan tersandi - hanya bisa dibuka akun Windows ini di komputer ini.'}"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- PasswordBox, bukan TextBox: token tidak boleh terbaca
                             orang yang kebetulan melihat layar. -->
                        <PasswordBox x:Name="TxtToken" Grid.Column="0" Margin="0,0,8,0"
                                     PasswordChanged="Token_Ubah" Padding="6,4,6,4"/>
                        <ui:Button x:Name="BtnUjiToken" Grid.Column="1"
                                   Content="{loc:T 'Uji token'}" Click="BtnUjiToken_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtToken2" TextWrapping="Wrap" Margin="0,0,0,6"
                               Style="{StaticResource SubJudul}" FontSize="12"/>
                    <ui:Button Content="{loc:T 'Cara membuat token'}" Margin="0,0,0,12"
                               HorizontalAlignment="Left" Click="BtnCaraToken_Click"/>
                    <WrapPanel>
                        <ui:Button x:Name="BtnCek" Content="{loc:T 'Cek pembaruan sekarang'}"
                                   Margin="0,0,8,0" Click="BtnCek_Click"/>
                        <ui:Button Content="{loc:T 'Buka halaman rilis'}" Click="BtnRilis_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtVersi" Opacity="0.6" FontSize="11" Margin="0,12,0,10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
