<UserControl x:Class="Phoron.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <UserControl.Resources>
        <Style x:Key="Kartu" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- Pintasan yang jarang dipakai, dibuka dari tombol "..." di baris PHP.
             Disimpan sebagai resource dan dibuka dari kode: ContextMenu yang
             ditempel ke tombol WPF UI tidak pernah terbuka, baik lewat klik
             maupun klik kanan. -->
        <ContextMenu x:Key="MenuPintasan">
            <MenuItem Header="{loc:T 'Buka www'}" Click="BtnWww_Click"/>
            <MenuItem Header="{loc:T 'Buka localhost'}" Click="BtnLocalhost_Click"/>
            <MenuItem Header="{loc:T 'Beranda Phoron'}" Click="BtnBeranda_Click"/>
            <MenuItem Header="{loc:T 'Terminal'}" Click="BtnTerminal_Click"/>
            <Separator/>
            <MenuItem Header="phpinfo()" Click="BtnPhpInfo_Click"/>
            <MenuItem Header="{loc:T 'Uji konfigurasi Apache'}" Click="BtnTest_Click"/>
            <MenuItem Tag="ssl" Header="{loc:T 'Buat sertifikat SSL'}" Click="BtnSsl_Click"/>
            <MenuItem Header="{loc:T 'Folder etc'}" Click="BtnEtc_Click"/>
        </ContextMenu>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="4,8,4,4">
            <TextBlock Text="{loc:T 'Beranda'}" Style="{StaticResource Judul}" Margin="0,0,0,10"/>

            <!-- Baris PHP. Bagi kebanyakan orang tumpukan PHP adalah latar: ia
                 menyala sendiri dan situsnya tinggal dibuka. Jadi cukup satu
                 baris yang tenang, dan baru mencolok kalau ada yang salah.
                 Rinciannya (PHP, web server, MySQL) ada tepat di bawahnya. -->
            <Border Style="{StaticResource Kartu}" Padding="14,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="DotRingkas" Width="12" Height="12" VerticalAlignment="Center" Margin="2,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="TxtRingkas" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtRingkasRinci" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="CmbProfil" SelectionChanged="CmbProfil_Changed" Width="250"
                                  VerticalAlignment="Center" ToolTip="{loc:T 'Profil aktif'}"/>
                        <!-- Hanya muncul bila profil lain dipilih di kotaknya. -->
                        <ui:Button Grid.Column="3" x:Name="BtnSwitchRun" Content="{loc:T 'Switch &amp; Jalankan'}"
                                   Appearance="Primary" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                                   ToolTip="{loc:T 'Pindah ke profil ini, lalu langsung nyalakan Apache dan MySQL'}"
                                   Click="BtnSwitchRun_Click"/>
                        <ui:Button Grid.Column="4" x:Name="BtnSwitch" Content="{loc:T 'Switch'}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" Visibility="Collapsed"
                                   ToolTip="{loc:T 'Pindah ke profil ini tanpa mengubah keadaan layanan'}"
                                   Click="BtnSwitch_Click"/>
                        <ui:Button Grid.Column="5" x:Name="BtnDayaBeranda" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Click="BtnDayaBeranda_Click"/>
                        <!-- Pintasan yang jarang dipakai: satu tombol, bukan delapan. -->
                        <ui:Button Grid.Column="6" x:Name="BtnPintasan" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Padding="10,6" ToolTip="{loc:T 'Pintasan'}" Click="BtnPintasan_Click">
                            <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </ui:Button>
                    </Grid>
                    <!-- Rincian PHP, web server, dan MySQL selalu terlihat sebagai satu
                         baris tiga kolom di dalam kartu yang sama: tidak perlu dibuka,
                         dan tidak ada kartu di dalam kartu. Garis tipis memisahkannya
                         dari baris status di atas. -->
                    <Border BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2">
                                <TextBlock Text="PHP" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="TxtPhp" Text="-" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtPhpSub" Text="" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Ellipse x:Name="DotKartuPhp" Width="8" Height="8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatusKartuPhp" FontSize="11" Opacity="0.8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2">
                                <TextBlock x:Name="TxtWebKind" Text="Apache" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="TxtWeb" Text="-" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtWebSub" Text="" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Ellipse x:Name="DotKartuWeb" Width="8" Height="8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatusKartuWeb" FontSize="11" Opacity="0.8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Column="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.ColumnSpan="2">
                                <TextBlock Text="MySQL" FontSize="11" Opacity="0.6"/>
                                <TextBlock x:Name="TxtDb" Text="-" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtDbSub" Text="" Opacity="0.7" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Ellipse x:Name="DotKartuDb" Width="8" Height="8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStatusKartuDb" FontSize="11" Opacity="0.8" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </Border>
                </StackPanel>
            </Border>


            <Border x:Name="PanelPeringatan" Style="{StaticResource Kartu}" Visibility="Collapsed"
                    Background="#33E0A020">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{loc:T 'Perhatian'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <!-- Menutup catatan yang SEDANG tampil. Catatan itu muncul
                             lagi bila keadaannya berubah - lihat CatatanDitutup. -->
                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="8,4" Margin="0,-6,-8,0"
                                   ToolTip="{loc:T 'Sembunyikan catatan ini'}" Click="BtnTutupPeringatan_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </ui:Button>
                    </Grid>
                    <TextBlock x:Name="TxtPeringatan" TextWrapping="Wrap"/>
                    <!-- Tombolnya ditaruh tepat di bawah keluhannya. Menyebut
                         masalah tanpa menyediakan jalan keluarnya di tempat yang
                         sama memaksa orang mencarinya sendiri di halaman lain. -->
                    <WrapPanel Margin="0,10,0,0">
                        <!-- Ditaruh SEBELUM tombol jalankan-ulang: inilah jalan
                             keluar yang benar untuk kebanyakan orang. Sekali
                             izin, sesudahnya tidak perlu admin lagi. -->
                        <ui:Button x:Name="BtnRestartKonfig" Content="{loc:T 'Nyalakan ulang layanan'}"
                                   Appearance="Primary" Margin="0,0,8,0"
                                   Visibility="Collapsed" Click="BtnRestartKonfig_Click"/>
                        <ui:Button x:Name="BtnDaftarHosts" Content="{loc:T 'Daftarkan nama situs sekali'}"
                                   Appearance="Primary" Margin="0,0,8,0"
                                   Visibility="Collapsed" Click="BtnDaftarHosts_Click"/>
                        <ui:Button x:Name="BtnAdmin" Content="{loc:T 'Jalankan ulang sebagai Administrator'}"
                                   Margin="0,0,8,0" Visibility="Collapsed" Click="BtnAdmin_Click"/>
                        <ui:Button x:Name="BtnPembaruan" Content="{loc:T 'Unduh pembaruan'}"
                                   Appearance="Primary" Margin="0,0,8,0"
                                   Visibility="Collapsed" Click="BtnPembaruan_Click"/>
                        <ui:Button x:Name="BtnBebaskan" Content="{loc:T 'Hentikan proses yang tertinggal'}"
                                   Appearance="Danger" Visibility="Collapsed" Click="BtnBebaskan_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Proyek Node: aksi yang paling sering dilakukan di Phoron. Kartu
                 dirakit dari kode (IsiNode); keluarannya dibaca dari
                 NodeRunner.Riwayat, jadi tetap ada walau halaman ini baru dibuka. -->
            <Grid Margin="0,6,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{loc:T 'Proyek Node'}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtJumlahNode" FontSize="13" Opacity="0.7" Margin="10,0,0,2" VerticalAlignment="Bottom"/>
                </StackPanel>
                <ui:Button HorizontalAlignment="Right" Content="{loc:T 'Kelola proyek'}" Click="BtnKelolaNode_Click"/>
            </Grid>
            <TextBlock x:Name="TxtNodeKosong" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,12"
                       Text="{loc:T 'Belum ada proyek Node. Tambahkan proyek Next.js, Vite, atau Astro di halaman Node, lalu jalankan dari sini atau dari menu baki.'}"/>
            <UniformGrid x:Name="DaftarNode" Columns="2" Margin="0,0,-12,0"/>

            <!-- Situs PHP yang terakhir dibuka lewat Phoron: satu klik ke browser. -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                <TextBlock Text="{loc:T 'Situs PHP terakhir'}" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
            <WrapPanel x:Name="PanelSitusTerakhir" Margin="0,0,0,12"/>

            <Border Style="{StaticResource Kartu}" Padding="14,6">
                <Expander x:Name="LipatAktivitas" Header="{loc:T 'Aktivitas'}" Padding="0,8,0,4">

                            <!-- RichTextBox, bukan TextBox: tiap baris perlu warnanya
                                 sendiri, dan teksnya harus tetap bisa disorot lalu
                                 disalin - itulah yang dilakukan orang dengan baris
                                 galat. Padding paragraf dinolkan supaya rapat seperti
                                 keluaran terminal. -->
                            <RichTextBox x:Name="TxtLog" IsReadOnly="True" IsDocumentEnabled="True"
                                         VerticalScrollBarVisibility="Auto" Height="150"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11"
                                         Background="{DynamicResource ControlFillColorDefaultBrush}"
                                         BorderThickness="1">
                                <RichTextBox.Resources>
                                    <Style TargetType="Paragraph">
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </RichTextBox.Resources>
                            </RichTextBox>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
