<UserControl x:Class="Phoron.App.Pages.DatabasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <UserControl.Resources>
        <Style x:Key="Kartu" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="JudulKartu" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Hampa" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16"/>
        </Style>

        <Style x:Key="Mungil" TargetType="ui:Button">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,14,2"/>
        </Style>

        <Style x:Key="Nilai" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,8,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:T 'Basis data'}" Style="{StaticResource Judul}"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource SubJudul}" Margin="0,0,8,0"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="KartuServer" VerticalAlignment="Center"
                    Visibility="Collapsed" Style="{StaticResource Kartu}" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#2FBF4F" VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtServer" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="PanelHalangan" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource Kartu}" Padding="22" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="TxtHalangan" TextWrapping="Wrap" FontWeight="SemiBold"
                           FontSize="14"/>
                <TextBlock x:Name="TxtHalanganRinci" TextWrapping="Wrap" Opacity="0.75"
                           Margin="0,8,0,0"/>
                <WrapPanel Margin="0,16,0,0">
                    <ui:Button x:Name="BtnNyalakan" Content="{loc:T 'Nyalakan MySQL'}"
                               Appearance="Primary" Margin="0,0,8,0" Click="BtnNyalakan_Click"/>
                    <ui:Button x:Name="BtnKeProfil" Content="{loc:T 'Buka Profil'}"
                               Margin="0,0,8,0" Click="BtnKeProfil_Click"/>
                    <ui:Button Content="{loc:T 'Coba lagi'}" Click="BtnMuatUlang_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="PanelIsi" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.4*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Kiri: daftar basis data. Sekadar untuk melihat apa yang ada dan
                 memilih sasaran impor/ekspor - menjelajah ISINYA tugas HeidiSQL,
                 dan Phoron tidak lagi punya penjelajah sendiri. -->
            <Border Grid.Column="0" Style="{StaticResource Kartu}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="LblDb" Style="{StaticResource JudulKartu}"
                               Text="{loc:T 'Basis data'}"/>
                    <ui:TextBox Grid.Row="1" x:Name="TxtCariDb" Margin="0,0,0,6"
                                PlaceholderText="{loc:T 'Cari...'}"
                                TextChanged="TxtCariDb_Ubah"/>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="DaftarDb" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="DaftarDb_Pilih"
                                 MouseDoubleClick="DaftarDb_KlikGanda">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Nama}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Ringkas}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="TxtDbHampa" Style="{StaticResource Hampa}"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,10,0,-6">
                        <ui:Button Content="{loc:T 'Buat...'}" Style="{StaticResource Mungil}"
                                   Margin="0,0,6,6" Click="BtnBuatDb_Click"/>
                        <ui:Button x:Name="BtnHapusDb" Content="{loc:T 'Hapus'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,6,6"
                                   Click="BtnHapusDb_Click"/>
                        <ui:Button Content="{loc:T 'Segarkan'}" Style="{StaticResource Mungil}"
                                   Margin="0,0,0,6" Click="BtnMuatUlang_Click"/>
                        <ui:Button x:Name="BtnImpor" Content="{loc:T 'Impor .sql...'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,6,6"
                                   Click="BtnImpor_Click"/>
                        <ui:Button x:Name="BtnEkspor" Content="{loc:T 'Ekspor .sql...'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,0,6"
                                   Click="BtnEkspor_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Kanan: HeidiSQL, dan keterangan sambungan yang dibutuhkan kalau
                 orang memakai alat lain. -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Kartu}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="22" VerticalAlignment="Center"
                                           Margin="0,0,12,0" Opacity="0.85"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="HeidiSQL" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtHeidiJalur" FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="TxtHeidiKeterangan" TextWrapping="Wrap" Opacity="0.8"
                                       Margin="0,0,0,14"/>

                            <WrapPanel>
                                <ui:Button x:Name="BtnHeidi" Appearance="Primary" Margin="0,0,8,6"
                                           Click="BtnHeidi_Click"
                                           Content="{loc:T 'Buka HeidiSQL'}"/>
                                <ui:Button x:Name="BtnCariHeidi" Style="{StaticResource Mungil}"
                                           Margin="0,0,8,6" Click="BtnCariHeidi_Click"
                                           Content="{loc:T 'Sebutkan jalurnya...'}"/>
                                <ui:Button x:Name="BtnLisensi" Style="{StaticResource Mungil}"
                                           Margin="0,0,0,6" Click="BtnLisensi_Click"
                                           Content="{loc:T 'Lisensi dan sumber'}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Keterangan sambungan. Ditulis apa adanya supaya alat lain -
                         DBeaver, TablePlus, atau kode aplikasi yang sedang dibuat -
                         bisa memakainya tanpa menebak-nebak. -->
                    <Border Style="{StaticResource Kartu}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:T 'Sambungan'}" Style="{StaticResource JudulKartu}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T 'Alamat'}"
                                           Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAlamat"
                                           Style="{StaticResource Nilai}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T 'Port'}"
                                           Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPort"
                                           Style="{StaticResource Nilai}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T 'Pengguna'}"
                                           Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPengguna"
                                           Style="{StaticResource Nilai}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T 'Sandi'}"
                                           Style="{StaticResource Label}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtSandi"
                                           FontSize="12" Margin="0,2" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Kartu}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:T 'Lewat terminal'}" Style="{StaticResource JudulKartu}"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12"
                                       Margin="0,0,0,8"
                                       Text="{loc:T 'Klien baris perintah mysql juga sudah siap - folder bin versi MySQL profil ini ada di PATH terminal Phoron.'}"/>
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="8,5">
                                <TextBlock x:Name="TxtPerintah" FontFamily="Consolas" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <ui:Button Content="{loc:T 'Buka terminal'}" Style="{StaticResource Mungil}"
                                       Margin="0,8,0,0" HorizontalAlignment="Left"
                                       Click="BtnTerminal_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus" TextTrimming="CharacterEllipsis"
                           FontSize="12" VerticalAlignment="Center"/>
                <ui:ProgressRing Grid.Column="1" x:Name="Putaran" Width="16" Height="16"
                                 IsIndeterminate="True" Visibility="Collapsed"/>
                <!-- Hanya selama ekspor/impor: keduanya tidak lagi punya batas
                     waktu, jadi penggunalah yang memutuskan kapan cukup. -->
                <ui:Button Grid.Column="2" x:Name="BtnBatal" Content="{loc:T 'Batal'}" Margin="10,0,0,0"
                           Padding="10,2" Visibility="Collapsed" Click="BtnBatal_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
