<UserControl x:Class="Phoron.App.Pages.DatabasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App"
             xmlns:dgp="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <UserControl.Resources>

        <!-- Kartu. Ketiga kolom memakai bingkai yang SAMA. Sebelumnya daftar
             basis data dibiarkan telanjang sementara daftar tabel punya bingkai
             sendiri dari gaya bawaan, dan hasilnya kolom kiri tampak seperti
             ruang kosong yang rusak, bukan seperti daftar yang kebetulan kosong. -->
        <Style x:Key="Kartu" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="JudulKartu" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Keterangan yang menempati ruang daftar saat daftarnya kosong.
             Daftar kosong tanpa sepatah kata pun membuat orang mengira layarnya
             yang rusak, bukan servernya yang memang belum berisi apa-apa. -->
        <Style x:Key="Hampa" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16"/>
        </Style>

        <Style x:Key="JudulKisi" TargetType="dgp:DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="JudulDaftar" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,1,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Isian" TargetType="DataGrid">
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource JudulKisi}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
        </Style>

        <Style x:Key="Mungil" TargetType="ui:Button">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="4,8,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kepala: judul di kiri, keterangan server di kanan. Versi, port, dan
             pengguna ditaruh permanen karena itulah tiga hal yang selalu jadi
             pertanyaan pertama saat sesuatu tidak jalan. -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{loc:T 'Basis data'}" Style="{StaticResource Judul}"/>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource SubJudul}" Margin="0,0,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" x:Name="KartuServer" VerticalAlignment="Center"
                    Visibility="Collapsed" Style="{StaticResource Kartu}" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#2FBF4F" VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtServer" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Panel penghalang. Halaman ini tidak punya apa pun untuk ditampilkan
             selama MySQL belum menjawab. Isinya bukan sekadar keluhan: ia
             menyebut sebabnya dan menyediakan tombol yang menyelesaikannya. -->
        <Border x:Name="PanelHalangan" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource Kartu}" Padding="22" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="TxtHalangan" TextWrapping="Wrap" FontWeight="SemiBold"
                           FontSize="14"/>
                <TextBlock x:Name="TxtHalanganRinci" TextWrapping="Wrap" Opacity="0.75"
                           Margin="0,8,0,0"/>
                <WrapPanel Margin="0,16,0,0">
                    <ui:Button x:Name="BtnNyalakan" Content="{loc:T 'Nyalakan MySQL'}"
                               Appearance="Primary" Margin="0,0,8,0" Click="BtnNyalakan_Click"/>
                    <ui:Button x:Name="BtnKeProfil" Content="{loc:T 'Buka Profil'}"
                               Margin="0,0,8,0" Click="BtnKeProfil_Click"/>
                    <ui:Button Content="{loc:T 'Coba lagi'}" Click="BtnMuatUlang_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid x:Name="PanelIsi" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Kolom 1: basis data -->
            <Border Grid.Column="0" Style="{StaticResource Kartu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="LblDb" Style="{StaticResource JudulKartu}"
                               Text="{loc:T 'Basis data'}"/>
                    <ui:TextBox Grid.Row="1" x:Name="TxtCariDb" Margin="0,0,0,6"
                                PlaceholderText="{loc:T 'Cari...'}"
                                TextChanged="TxtCariDb_Ubah"/>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="DaftarDb" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="DaftarDb_Pilih">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1">
                                        <TextBlock Text="{Binding Nama}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Ringkas}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="TxtDbHampa" Style="{StaticResource Hampa}"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,-6">
                        <ui:Button Content="{loc:T 'Buat...'}" Style="{StaticResource Mungil}"
                                   Margin="0,0,6,6" Click="BtnBuatDb_Click"/>
                        <ui:Button x:Name="BtnHapusDb" Content="{loc:T 'Hapus'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,6,6"
                                   Click="BtnHapusDb_Click"/>
                        <ui:Button Content="{loc:T 'Segarkan'}" Style="{StaticResource Mungil}"
                                   Margin="0,0,0,6" Click="BtnMuatUlang_Click"/>
                        <ui:Button x:Name="BtnImpor" Content="{loc:T 'Impor .sql...'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,6,6"
                                   Click="BtnImpor_Click"/>
                        <ui:Button x:Name="BtnEkspor" Content="{loc:T 'Ekspor .sql...'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,0,6"
                                   Click="BtnEkspor_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Kolom 2: tabel -->
            <Border Grid.Column="2" Style="{StaticResource Kartu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="LblTabel" Style="{StaticResource JudulKartu}"
                               Text="{loc:T 'Tabel'}"/>
                    <ui:TextBox Grid.Row="1" x:Name="TxtCariTabel" Margin="0,0,0,6"
                                PlaceholderText="{loc:T 'Cari...'}"
                                TextChanged="TxtCariTabel_Ubah"/>

                    <Grid Grid.Row="2">
                        <ListView x:Name="DaftarTabel" BorderThickness="0" Background="Transparent"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  SelectionChanged="DaftarTabel_Pilih"
                                  MouseDoubleClick="DaftarTabel_KlikGanda">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource JudulDaftar}">
                                    <GridViewColumn Header="{loc:T 'Nama'}" Width="128"
                                                    DisplayMemberBinding="{Binding Nama}"/>
                                    <GridViewColumn Header="{loc:T 'Baris'}" Width="84"
                                                    DisplayMemberBinding="{Binding BarisTampil}"/>
                                    <GridViewColumn Header="{loc:T 'Ukuran'}" Width="74"
                                                    DisplayMemberBinding="{Binding Ukuran}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="TxtTabelHampa" Style="{StaticResource Hampa}"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <ui:Button x:Name="BtnKosongkan" Content="{loc:T 'Kosongkan tabel'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,6,0"
                                   Click="BtnKosongkan_Click"/>
                        <ui:Button x:Name="BtnHapusTabel" Content="{loc:T 'Hapus tabel'}"
                                   Style="{StaticResource Mungil}" Margin="0,0,6,0"
                                   Click="BtnHapusTabel_Click"/>
                        <ui:Button x:Name="BtnStruktur" Content="{loc:T 'Struktur'}"
                                   Style="{StaticResource Mungil}" Click="BtnStruktur_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Kolom 3: Jelajah / Struktur / SQL.
                 Dipisah jadi tab, mengikuti pembagian yang sudah dikenal orang
                 dari phpMyAdmin. Sebelumnya kotak SQL dan hasilnya berdesakan di
                 satu kolom sempit: kotaknya hanya muat tiga baris, dan kisinya
                 hanya kebagian sisa ruang. -->
            <Border Grid.Column="4" Style="{StaticResource Kartu}" Padding="6">
                <TabControl x:Name="Tab" BorderThickness="0" Background="Transparent"
                            SelectionChanged="Tab_Ubah">

                    <TabItem Header="{loc:T 'Jelajah'}">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Name="LblJelajah"
                                       Style="{StaticResource JudulKartu}" Margin="2,0,0,6"/>

                            <Grid Grid.Row="1">
                                <DataGrid x:Name="Kisi" Style="{StaticResource Isian}"
                                          CanUserSortColumns="True" Sorting="Kisi_Urut"/>
                                <TextBlock x:Name="TxtKisiHampa" Style="{StaticResource Hampa}"
                                           Visibility="Collapsed"/>
                            </Grid>

                            <!-- Bilah halaman. Batas 500 yang dulu dipasang mati
                                 berarti baris ke-501 tidak pernah bisa dilihat
                                 sama sekali. -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <ui:Button x:Name="BtnAwal" Content="&#xE892;"
                                               FontFamily="Segoe MDL2 Assets" Style="{StaticResource Mungil}"
                                               Margin="0,0,4,0" Click="BtnAwal_Click"
                                               ToolTip="{loc:T 'Halaman pertama'}"/>
                                    <ui:Button x:Name="BtnMundur" Content="&#xE76B;"
                                               FontFamily="Segoe MDL2 Assets" Style="{StaticResource Mungil}"
                                               Margin="0,0,8,0" Click="BtnMundur_Click"/>
                                    <TextBlock x:Name="TxtHalaman" VerticalAlignment="Center"
                                               FontSize="12" Opacity="0.8" MinWidth="150"/>
                                    <ui:Button x:Name="BtnMaju" Content="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets" Style="{StaticResource Mungil}"
                                               Margin="8,0,0,0" Click="BtnMaju_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{loc:T 'Baris per halaman'}" FontSize="12"
                                               Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbPerHalaman" Width="80"
                                              SelectionChanged="CmbPerHalaman_Ubah">
                                        <ComboBoxItem Content="50"/>
                                        <ComboBoxItem Content="100" IsSelected="True"/>
                                        <ComboBoxItem Content="500"/>
                                        <ComboBoxItem Content="1000"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{loc:T 'Struktur'}">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="90"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="90"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:T 'Kolom'}"
                                           Style="{StaticResource JudulKartu}"/>
                                <DataGrid Grid.Row="1" x:Name="KisiKolom" Style="{StaticResource Isian}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:T 'Nama'}" Width="1.7*"
                                                            Binding="{Binding Nama}"/>
                                        <DataGridTextColumn Header="{loc:T 'Jenis'}" Width="1.5*"
                                                            Binding="{Binding Jenis}"/>
                                        <DataGridTextColumn Header="{loc:T 'Boleh kosong'}" Width="Auto"
                                                            Binding="{Binding Kosong}"/>
                                        <DataGridTextColumn Header="{loc:T 'Kunci'}" Width="Auto"
                                                            Binding="{Binding Kunci}"/>
                                        <DataGridTextColumn Header="{loc:T 'Bawaan'}" Width="1.2*"
                                                            Binding="{Binding Bawaan}"/>
                                        <DataGridTextColumn Header="{loc:T 'Ekstra'}" Width="1.3*"
                                                            Binding="{Binding Ekstra}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{loc:T 'Indeks'}"
                                       Style="{StaticResource JudulKartu}" Margin="2,10,0,6"/>
                            <DataGrid Grid.Row="2" x:Name="KisiIndeks" Style="{StaticResource Isian}"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:T 'Nama'}" Width="1.5*"
                                                        Binding="{Binding Nama}"/>
                                    <DataGridTextColumn Header="{loc:T 'Kolom'}" Width="2.2*"
                                                        Binding="{Binding Kolom}"/>
                                    <DataGridTextColumn Header="{loc:T 'Sifat'}" Width="Auto"
                                                        Binding="{Binding Sifat}"/>
                                    <DataGridTextColumn Header="{loc:T 'Jenis'}" Width="Auto"
                                                        Binding="{Binding Jenis}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                <ui:Button Content="{loc:T 'Lihat CREATE TABLE'}"
                                           Style="{StaticResource Mungil}" Margin="0,0,6,0"
                                           Click="BtnCreateTable_Click"/>
                                <ui:Button Content="{loc:T 'Salin struktur'}"
                                           Style="{StaticResource Mungil}" Click="BtnSalinStruktur_Click"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{loc:T 'SQL'}">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="140" MinHeight="70"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="80"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="LblSql"
                                           Style="{StaticResource JudulKartu}" Margin="2,0,0,0"/>
                                <ComboBox Grid.Column="1" x:Name="CmbRiwayat" Width="220"
                                          SelectionChanged="CmbRiwayat_Pilih"/>
                            </Grid>

                            <ui:TextBox Grid.Row="1" x:Name="TxtSql" AcceptsReturn="True"
                                        AcceptsTab="True" FontFamily="Consolas" FontSize="13"
                                        TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Auto"
                                        PreviewKeyDown="TxtSql_Tombol"/>

                            <WrapPanel Grid.Row="2" Margin="0,8,0,8">
                                <ui:Button x:Name="BtnJalankan" Content="{loc:T 'Jalankan (Ctrl+Enter)'}"
                                           Appearance="Primary" Margin="0,0,8,0" Click="BtnJalankan_Click"/>
                                <ui:Button Content="{loc:T 'Bersihkan'}" Margin="0,0,8,0"
                                           Click="BtnBersih_Click"/>
                                <ui:Button Content="{loc:T 'Salin hasil'}" Click="BtnSalin_Click"/>
                            </WrapPanel>

                            <Grid Grid.Row="3">
                                <DataGrid x:Name="KisiSql" Style="{StaticResource Isian}"/>
                                <TextBlock x:Name="TxtSqlHampa" Style="{StaticResource Hampa}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Bilah status. Satu tempat tetap untuk hasil perbuatan terakhir,
             supaya pesan tidak muncul bergantian di sudut yang berpindah-pindah. -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,6" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus" TextTrimming="CharacterEllipsis"
                           FontSize="12" VerticalAlignment="Center"/>
                <ui:ProgressRing Grid.Column="1" x:Name="Putaran" Width="16" Height="16"
                                 IsIndeterminate="True" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
