<UserControl x:Class="Phoron.App.Pages.VersionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <Grid Margin="4,8,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T 'Versi terpasang'}" Style="{StaticResource Judul}"/>
            <TextBlock Style="{StaticResource SubJudul}"
                       Text="{loc:T 'Semua folder versi yang ditemukan di folder bin yang terdaftar. Folder bin Laragon ikut dipindai bila ada.'}"/>
        </StackPanel>

        <ListView x:Name="Daftar" Grid.Row="1" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:T 'Jenis'}" Width="80" DisplayMemberBinding="{Binding Jenis}"/>
                    <GridViewColumn Header="{loc:T 'Versi'}" Width="90" DisplayMemberBinding="{Binding Versi}"/>
                    <GridViewColumn Header="{loc:T 'Toolset'}" Width="80" DisplayMemberBinding="{Binding Toolset}"/>
                    <GridViewColumn Header="{loc:T 'Arsitektur'}" Width="90" DisplayMemberBinding="{Binding Arsitektur}"/>
                    <GridViewColumn Header="{loc:T 'Folder'}" Width="290" DisplayMemberBinding="{Binding Folder}"/>
                    <GridViewColumn Header="{loc:T 'Sumber'}" Width="200" DisplayMemberBinding="{Binding Sumber}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2">
            <!-- Pindah ke sini dari Pengaturan: daftar folder bin adalah SEBAB
                 dari isi tabel di atas, jadi tempatnya bersebelahan dengan
                 akibatnya, bukan di halaman setelan yang isinya hal lain. -->
            <TextBlock Text="{loc:T 'Folder bin yang dipindai'}" Style="{StaticResource Label}"/>
            <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="0,0,0,6"
                       Text="{loc:T 'Satu folder per baris. Folder bin milik Laragon, XAMPP, atau WAMP boleh ikut - Phoron tidak pernah menulis ke dalamnya.'}"/>
            <!-- Disimpan saat kehilangan fokus, bukan tiap ketukan: mengubah
                 daftar folder bin memicu pemindaian ulang seluruh versi, dan
                 melakukannya per huruf yang diketik akan membuat kotak ini macet. -->
            <ui:TextBox x:Name="TxtRoots" AcceptsReturn="True" Height="80" Margin="0,0,0,10"
                        TextWrapping="NoWrap" VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto" LostFocus="TxtRoots_Lepas"/>

            <WrapPanel Margin="0,0,0,10">
                <ui:Button Content="{loc:T 'Pindai ulang'}" Margin="0,0,8,0" Click="BtnPindai_Click"/>
                <ui:Button Content="{loc:T 'Tambah folder bin'}" Margin="0,0,8,0" Click="BtnTambahRoot_Click"/>
                <ui:Button Content="{loc:T 'Buka folder versi'}" Margin="0,0,8,0" Click="BtnBuka_Click"/>
                <ui:Button Click="BtnKatalog_Click">
                    <ui:Button.Content>
                        <!-- Bentuk elemen: parser markup extension memakan "\". -->
                        <loc:T Teks="Katalog unduhan (etc\catalog.ini)"/>
                    </ui:Button.Content>
                </ui:Button>
            </WrapPanel>

            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="{loc:T 'Pasang versi baru'}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbSumber" Grid.Column="0" Margin="0,0,8,0"
                                  SelectionChanged="CmbSumber_Changed">
                            <ComboBoxItem Content="PHP (windows.php.net)" Tag="php" IsSelected="True"/>
                            <ComboBoxItem Content="{loc:T 'Katalog lokal'}" Tag="katalog"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbPaket" Grid.Column="1" Margin="0,0,8,0"/>
                        <ui:Button x:Name="BtnPasang" Grid.Column="2" Content="{loc:T 'Unduh &amp; pasang'}"
                                   Appearance="Primary" Click="BtnPasang_Click"/>
                    </Grid>
                    <ProgressBar x:Name="Bar" Height="4" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" Opacity="0.75" TextWrapping="Wrap"
                               Text="{loc:T 'Paket diunduh ke folder bin milik Phoron, tidak menyentuh folder Laragon.'}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
