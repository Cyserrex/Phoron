<UserControl x:Class="Phoron.App.Pages.SitesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="4,8,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Situs" Style="{StaticResource Judul}"/>
            <TextBlock x:Name="TxtInfo" Style="{StaticResource SubJudul}"
                       Text="Tiap subfolder di www otomatis dapat alamat sendiri."/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtSitusBaru" Grid.Column="0" Margin="0,0,8,0"
                            PlaceholderText="nama-proyek-baru"/>
                <!-- Pemilih folder hanya muncul kalau profil punya lebih dari satu;
                     dengan satu folder, pertanyaannya tidak ada gunanya. -->
                <ComboBox x:Name="CmbRootBaru" Grid.Column="1" Margin="0,0,8,0" MinWidth="180"
                          Visibility="Collapsed"/>
                <ui:Button Grid.Column="2" Content="Buat situs" Appearance="Primary" Click="BtnBuat_Click"/>
            </Grid>
        </Border>

        <ListView x:Name="Daftar" Grid.Row="2" Margin="0,0,0,10"
                  MouseDoubleClick="Daftar_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Alamat" Width="215" DisplayMemberBinding="{Binding Alamat}"/>
                    <GridViewColumn Header="Folder" Width="150" DisplayMemberBinding="{Binding Folder}"/>
                    <GridViewColumn Header="Folder proyek" Width="185" DisplayMemberBinding="{Binding Root}"/>
                    <GridViewColumn Header="Document root" Width="150" DisplayMemberBinding="{Binding DocRoot}"/>
                    <GridViewColumn Header="hosts" Width="70" DisplayMemberBinding="{Binding Hosts}"/>
                    <GridViewColumn Header="vhost" Width="70" DisplayMemberBinding="{Binding Vhost}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="3">
            <ui:Button Content="Buka di browser" Margin="0,0,8,0" Click="BtnBuka_Click"/>
            <ui:Button Content="Buka folder" Margin="0,0,8,0" Click="BtnFolder_Click"/>
            <ui:Button Content="Terminal di sini" Margin="0,0,8,0" Click="BtnTerminal_Click"/>
            <ui:Button Content="Segarkan &amp; sinkronkan" Margin="0,0,8,0" Click="BtnSegarkan_Click"/>
            <ui:Button Content="Buka berkas hosts" Click="BtnHosts_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
