<UserControl x:Class="Phoron.App.Pages.SitesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App">
    <Grid Margin="4,8,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T 'Situs'}" Style="{StaticResource Judul}"/>
            <TextBlock x:Name="TxtInfo" Style="{StaticResource SubJudul}"
                       Text="{loc:T 'Tiap subfolder di www otomatis dapat alamat sendiri.'}"/>
        </StackPanel>

        <!-- Pindah ke sini dari halaman Profil: folder proyek adalah SEBAB dari
             daftar situs di bawah, jadi menyuntingnya di tempat lain membuat
             orang bolak-balik hanya untuk melihat akibat perubahannya. -->
        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="LblFolderProyek" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                <TextBlock Style="{StaticResource SubJudul}" FontSize="12" Margin="0,0,0,6"
                           Text="{loc:T 'Satu folder per baris; boleh lebih dari satu. Yang paling atas jadi akar utama (dilayani http://localhost). Kosongkan untuk memakai www bawaan.'}"/>
                <ui:TextBox x:Name="TxtDocRoot" AcceptsReturn="True" Height="70"
                            TextWrapping="NoWrap" VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto" LostFocus="TxtDocRoot_Lepas"/>
                <WrapPanel Margin="0,6,0,0">
                    <ui:Button Content="{loc:T 'Tambah folder...'}" Margin="0,0,8,0"
                               Click="BtnPilihFolder_Click"/>
                    <TextBlock x:Name="TxtStatusRoot" VerticalAlignment="Center"
                               Style="{StaticResource SubJudul}" FontSize="12"/>
                </WrapPanel>

                <!-- Tempat ini dulu diisi kotak "nama-proyek-baru" berikut
                     tombolnya, dan keterangan seperti nama situs yang bentrok
                     dimunculkan sebagai kotak dialog - yang harus ditutup lebih
                     dulu setiap kali halaman ini dibuka. Sekarang terbalik:
                     keterangannya menetap di sini, dan pembuatan situs pindah ke
                     tombol di baris bawah. Yang jarang disentuh tidak layak
                     menempati ruang terbaik, dan yang perlu diketahui tidak layak
                     menghalangi jalan. -->
                <Border x:Name="PanelInfo" Visibility="Collapsed" Margin="0,12,0,0"
                        Background="#33E0A020" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="LblInfo" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtInfoSitus" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Pemilih folder dipakai saat membuat situs; tetap ada tapi
                     tidak perlu terlihat, karena hanya berarti bila profil punya
                     lebih dari satu folder proyek. -->
                <ComboBox x:Name="CmbRootBaru" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <ListView x:Name="Daftar" Grid.Row="2" Margin="0,0,0,10"
                  MouseDoubleClick="Daftar_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:T 'Alamat'}" Width="215" DisplayMemberBinding="{Binding Alamat}"/>
                    <GridViewColumn Header="{loc:T 'Folder'}" Width="150" DisplayMemberBinding="{Binding Folder}"/>
                    <GridViewColumn Header="{loc:T 'Folder proyek'}" Width="185" DisplayMemberBinding="{Binding Root}"/>
                    <GridViewColumn Header="{loc:T 'Document root'}" Width="150" DisplayMemberBinding="{Binding DocRoot}"/>
                    <GridViewColumn Header="{loc:T 'hosts'}" Width="70" DisplayMemberBinding="{Binding Hosts}"/>
                    <GridViewColumn Header="{loc:T 'vhost'}" Width="70" DisplayMemberBinding="{Binding Vhost}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <WrapPanel Grid.Row="3">
            <ui:Button Content="{loc:T 'Buat situs'}" Appearance="Primary" Margin="0,0,8,0" Click="BtnBuat_Click"/>
            <ui:Button Content="{loc:T 'Buka di browser'}" Margin="0,0,8,0" Click="BtnBuka_Click"/>
            <ui:Button Content="{loc:T 'Buka folder'}" Margin="0,0,8,0" Click="BtnFolder_Click"/>
            <ui:Button Content="{loc:T 'Terminal di sini'}" Margin="0,0,8,0" Click="BtnTerminal_Click"/>
            <ui:Button Content="{loc:T 'Segarkan &amp; sinkronkan'}" Margin="0,0,8,0" Click="BtnSegarkan_Click"/>
            <ui:Button Content="{loc:T 'Buka berkas hosts'}" Click="BtnHosts_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
