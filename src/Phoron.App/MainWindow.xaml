<ui:FluentWindow x:Class="Phoron.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App"
                 Title="Phoron" Width="1120" Height="740"
                 MinWidth="900" MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <!-- Ikon navigasi memakai Segoe MDL2 Assets, bukan ikon paket tema:
             fontnya ada di tiap Windows 10/11 dan namanya tidak berubah
             antarversi pustaka. -->
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ikonnya dipasang dari kode, diambil dari ikon Win32 exe-nya sendiri;
             lihat PasangIkon() di code-behind. -->
        <ui:TitleBar x:Name="BilahJudul" Grid.Row="0" Title="Phoron" ShowMaximize="True"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel kiri: navigasi di atas, ringkasan status + tombol besar di
                 bawah. Statusnya sengaja selalu terlihat: pertanyaan pertama
                 pengguna aplikasi semacam ini selalu "ini lagi nyala atau tidak". -->
            <Border Grid.Column="0" Margin="8,0,4,8" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="Nav" Grid.Row="0" Margin="6,10,6,0"
                             BorderThickness="0" Background="Transparent"
                             SelectionChanged="Nav_SelectionChanged">
                        <ListBoxItem Tag="beranda">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Beranda'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="profil">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81E;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Profil'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="versi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Versi'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="situs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Situs'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="basisdata">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE968;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Basis data'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="node">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE756;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Node / TS'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="ekstensi">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Ekstensi PHP'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="log">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Log'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="setelan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Pengaturan'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="tentang">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Tentang'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="12,10,12,12">
                        <TextBlock x:Name="TxtProfil" Text="-" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="DotWeb" Width="10" Height="10" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtWeb" Text="{loc:T 'Apache berhenti'}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="DotDb" Width="10" Height="10" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtDb" Text="{loc:T 'MySQL berhenti'}" FontSize="12"/>
                        </StackPanel>
                        <ui:Button x:Name="BtnPower" Content="{loc:T 'Nyalakan semua'}"
                                   Appearance="Primary" HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Click="BtnPower_Click"/>
                        <!-- Keluar ditaruh di sini, bukan hanya di menu baki
                             sistem: menutup aplikasi tidak seharusnya menuntut
                             orang mencari ikon tersembunyi lalu klik kanan. -->
                        <ui:Button x:Name="BtnKeluar" Content="{loc:T 'Keluar'}" Margin="0,6,0,0"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   ToolTip="Tutup Phoron sepenuhnya dan matikan semua layanan"
                                   Click="BtnKeluar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl x:Name="Host" Margin="8,0,12,12"/>

                <!-- Bantuan tab yang sedang terbuka. Mengambang di pojok kanan
                     atas, di luar isi halaman, jadi ikut ada di semua tab tanpa
                     tiap halaman perlu menyediakan tempat sendiri. -->
                <ui:Button x:Name="BtnBantuan" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,10,34,0" Padding="10,5" Appearance="Secondary"
                           ToolTip="{loc:T 'Bantuan untuk halaman ini'}" Click="BtnBantuan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T 'Bantuan'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <Border x:Name="PanelBantuan" Visibility="Collapsed" Width="400"
                        HorizontalAlignment="Right" Margin="0,0,12,12" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,10,6">
                            <TextBlock x:Name="TxtBantuanJudul" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,40,0"/>
                            <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="8,4"
                                       ToolTip="{loc:T 'Tutup'}" Click="BtnTutupBantuan_Click">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </ui:Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,16">
                            <StackPanel x:Name="IsiBantuan"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
