<ui:FluentWindow x:Class="Phoron.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:Phoron.App"
                 Title="Phoron" Width="960" Height="640"
                 MinWidth="760" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <!-- Ikon navigasi memakai Segoe MDL2 Assets, bukan ikon paket tema:
             fontnya ada di tiap Windows 10/11 dan namanya tidak berubah
             antarversi pustaka. -->
        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="70"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ikonnya dipasang dari kode, diambil dari ikon Win32 exe-nya sendiri;
             lihat PasangIkon() di code-behind. -->
        <ui:TitleBar x:Name="BilahJudul" Grid.Row="0" Title="Phoron" ShowMaximize="True"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rail ikon berlabel. Ikon tanpa tulisan memaksa orang menebak atau
                 menunggu tooltip; label kecil di bawah ikonnya menjawab itu,
                 dan rail ini tetap jauh lebih sempit daripada panel 220 px lama,
                 jadi halaman mendapat ruang lebih.
                 Urutannya mengikuti pemakaian: kerja harian di atas, konfigurasi
                 di tengah, sistem di bawah. -->
            <Border Grid.Column="0" Margin="6,0,2,8" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="Nav" Grid.Row="0" Margin="4,8,4,0"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Nav_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="2,4,2,3"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Tag="beranda">
                            <StackPanel>
                                <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Beranda'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="node">
                            <StackPanel>
                                <TextBlock Text="&#xE756;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Node / TS'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="situs">
                            <StackPanel>
                                <TextBlock Text="&#xE774;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Situs'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="basisdata">
                            <StackPanel>
                                <TextBlock Text="&#xE968;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Basis data'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem IsEnabled="False" Focusable="False" Padding="0" MinHeight="0"><Rectangle Height="1" Width="44" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,2"/></ListBoxItem>
                        <ListBoxItem Tag="profil">
                            <StackPanel>
                                <TextBlock Text="&#xE81E;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Profil'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="versi">
                            <StackPanel>
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Versi'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="ekstensi">
                            <StackPanel>
                                <TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Ekstensi PHP'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem IsEnabled="False" Focusable="False" Padding="0" MinHeight="0"><Rectangle Height="1" Width="44" Fill="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,2"/></ListBoxItem>
                        <ListBoxItem Tag="log">
                            <StackPanel>
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Log'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="setelan">
                            <StackPanel>
                                <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Pengaturan'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="tentang">
                            <StackPanel>
                                <TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}"/>
                                <TextBlock Text="{loc:T 'Tentang'}" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Status selalu terlihat, dalam bentuk ringkas: dua titik
                         (web, MySQL) dengan keterangan di tooltip, tombol daya,
                         dan tombol keluar. Teks lengkapnya ada di baris PHP Beranda. -->
                    <StackPanel Grid.Row="1" Margin="4,4,4,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Ellipse x:Name="DotWeb" Width="9" Height="9" Fill="Gray" Margin="0,0,8,0"/>
                            <Ellipse x:Name="DotDb" Width="9" Height="9" Fill="Gray"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtProfil" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtWeb" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtDb" Visibility="Collapsed"/>
                        <!-- Daya, tampilan ringkas, dan keluar dalam satu baris: rail
                             harus muat di jendela setinggi 600 px tanpa menggulir.
                             Keluar ditaruh di sini, bukan hanya di menu baki sistem:
                             menutup aplikasi tidak seharusnya menuntut orang mencari
                             ikon tersembunyi lalu klik kanan. -->
                        <UniformGrid Columns="3">
                            <ui:Button x:Name="BtnPower" Appearance="Primary" Margin="0,0,2,0" Padding="0,7"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       Click="BtnPower_Click">
                                <TextBlock x:Name="IkonPower" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </ui:Button>
                            <ui:Button x:Name="BtnRingkas" Margin="1,0,1,0" Padding="0,7"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       ToolTip="{loc:T 'Tampilan ringkas'}" Click="BtnRingkas_Click">
                                <TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </ui:Button>
                            <ui:Button x:Name="BtnKeluar" Margin="2,0,0,0" Padding="0,7"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       ToolTip="{loc:T 'Tutup Phoron sepenuhnya dan matikan semua layanan'}"
                                       Click="BtnKeluar_Click">
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                            </ui:Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl x:Name="Host" Margin="8,0,12,12"/>

                <!-- Bantuan tab yang sedang terbuka. Mengambang di pojok kanan
                     atas, di luar isi halaman, jadi ikut ada di semua tab tanpa
                     tiap halaman perlu menyediakan tempat sendiri. -->
                <ui:Button x:Name="BtnBantuan" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,10,34,0" Padding="10,5" Appearance="Secondary"
                           ToolTip="{loc:T 'Bantuan untuk halaman ini'}" Click="BtnBantuan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T 'Bantuan'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <Border x:Name="PanelBantuan" Visibility="Collapsed" Width="400"
                        HorizontalAlignment="Right" Margin="0,0,12,12" CornerRadius="8"
                        BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="18,14,10,6">
                            <TextBlock x:Name="TxtBantuanJudul" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,40,0"/>
                            <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="8,4"
                                       ToolTip="{loc:T 'Tutup'}" Click="BtnTutupBantuan_Click">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </ui:Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,18,16">
                            <StackPanel x:Name="IsiBantuan"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
