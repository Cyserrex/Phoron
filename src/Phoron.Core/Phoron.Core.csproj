<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Phoron.Core</RootNamespace>
    <AssemblyName>Phoron.Core</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.20.0</Version>
  </PropertyGroup>

  <!--
    Sengaja tanpa satu pun PackageReference. Seluruh isi Core hanya menyentuh
    berkas teks, proses, dan soket - semuanya ada di BCL. Nol dependensi berarti
    exe akhirnya tetap satu berkas tanpa perlu menanam DLL pihak ketiga.
  -->
  <ItemGroup>
    <!-- ProtectedData (DPAPI) untuk menyandikan token GitHub. Bagian dari
         .NET Framework, jadi tetap nol dependensi pihak ketiga. -->
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
